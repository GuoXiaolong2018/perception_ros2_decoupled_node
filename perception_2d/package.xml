<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>perception_2d</name>
  <version>0.1.0</version>
  <description>统一 2D 感知入口：按 backend 启动 YOLO 或 YOLOE，发布统一话题前缀 /perception_2d/</description>
  <maintainer email="GuoXiaolong2018@users.noreply.github.com">Guo Xiaolong</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>yolo_detection</exec_depend>
  <exec_depend>yoloe_segmentation</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
