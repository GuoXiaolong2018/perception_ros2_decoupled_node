<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>perception_detections_to_base</name>
  <version>0.1.0</version>
  <description>将相机系 3D 检测点变换到机器人 base 坐标系并发布 JSON。</description>
  <maintainer email="GuoXiaolong2018@users.noreply.github.com">Guo Xiaolong</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>vision_msgs</depend>
  <depend>ament_index_python</depend>
  <exec_depend>perception_pose_visualization</exec_depend>
  <exec_depend>perception_2d</exec_depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
